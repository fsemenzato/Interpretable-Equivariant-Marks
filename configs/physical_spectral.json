{
  "extends": "training_base.json",
  "save_dir": "../runs/physical_spectral",
  "_model_class": "MarkSH",
  "bootstrap_pretrain_from": "../runs/pretrain_d16/best_checkpoint.pt",
  "sh_basis": "physical",
  "radial": "fourier_mlp",
  "taper": "cosine",
  "mark_positivity": "softplus",
  "l_max": 2,
  "n_radial_basis": 12,
  "k0_frac": 0.2,
  "radial_hidden": 16,
  "radial_n_fourier": 8,
  "nyquist_taper_kpass": 0.85,
  "nyquist_taper_floor": 0.0,
  "mas_taper_power": 4.0,
  "dc_normalize": true,
  "subtract_dc_high_l": false,
  "l2_normalize_l0": false,
  "l2_normalize_high_l": false,
  "input_transform": "log1p",
  "gam_hidden_dim": 16,
  "cross_hidden_dim": 8,
  "cross_inputs": [
    "E0",
    "E2",
    "I3_norm"
  ],
  "batch_size": 16,
  "num_epochs": 700,
  "marker_lr_multiplier": 2.0,
  "theta_projector_lr_multiplier": 0.25,
  "pdd_projector_lr_multiplier": 0.0,
  "loss_function": "conditional_infonce",
  "similarity_mode": "mahalanobis",
  "ortho_mode": "embedding",
  "projector_depth": 2
}
